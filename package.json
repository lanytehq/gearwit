{
  "name": "gearwit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "scripts": {
    "check:js": "bun run typecheck && bun run test:js && bun run --filter @gearwit/console build",
    "test:js": "vitest run",
    "typecheck": "bun run --filter @gearwit/console typecheck"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.3.9"
}
